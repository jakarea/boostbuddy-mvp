generator client {
  provider = "prisma-client"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  name         String
  role         String           // "ADMIN", "CLIENT", or "EMPLOYEE"
  status       String           @default("PENDING") // "PENDING", "ACTIVE", "DEACTIVATED"
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Credits & Employee System
  creditsBalance     Int       @default(0)  // Cached credits balance
  acceptingOrders    Boolean   @default(true)  // Employee availability toggle
  telegramChatId     String?   // Telegram Chat ID for notifications
  preferredLanguage  String    @default("en")  // Preferred notification language: "en" or "it"

  // Existing Relations
  billingInfo         BillingInfo?
  profiles            ProfileAccount[]
  orders              Order[]
  invoices            Invoice[]

  // New Relations - Credits & Reviews
  creditTransactions        CreditTransaction[]
  reviewOrdersAsClient      ReviewOrder[]       @relation("ReviewOrderClient")
  reviewOrdersAsEmployee   ReviewOrder[]       @relation("ReviewOrderEmployee")
  reviewOrdersCompleted    ReviewOrder[]       @relation("ReviewOrderCompletedBy")  // NEW
  employeeStats             EmployeeStats?
  employeeEarnings          EmployeeEarnings?
  notifications             Notification[]
  notificationLogs           NotificationLog[]

  @@index([role, status])
  @@index([createdAt])
  userTelegramConfig        UserTelegramConfig?

  // New Relations - Reviews System Redesign
  assignedReviewUrls    ReviewUrl[]            @relation("ReviewUrlEmployee")
}

model BillingInfo {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingType String   // "INDIVIDUAL" or "COMPANY"
  country     String
  name        String   // Individual name or company name
  address     String
  city        String
  postalCode  String
  vatNumber   String?
  fiscalCode  String?
  sdiCode     String?  // SDI code for Italy, if applicable
  updatedAt   DateTime @updatedAt
}

model Service {
  id                       String   @id @default(uuid())
  name                     String
  description              String
  price                    Float
  durationDays             Int      @map("duration_days")
  isActive                 Boolean  @default(true) @map("is_active")
  requiresManualAssignment Boolean  @default(true) @map("requires_manual_assignment")
  instructions             String   // Client-visible instructions on how to use/assign
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  orders                   Order[]
  profiles                 ProfileAccount[]
}

model ProfileAccount {
  id                 String    @id @default(uuid())
  profileName        String    // e.g. "IX-Profile-001"
  accountEmail       String
  accountPassword    String
  emailPassword      String?
  twoFactorSecret    String?   // 2FA code / secret key
  iXBrowserProfileId String?   // IXBrowser profile ID or reference code
  iXBrowserGroup     String?   // IXBrowser profile group
  status             String    // "AVAILABLE", "ASSIGNED", "ACTIVE", "EXPIRED", "BANNED", "CANCELLED", "REQUEST_CHANGE"
  adminNotes         String?
  clientNotes        String?   // Client-visible notes/instructions
  assignedClientId   String?
  assignedClient     User?            @relation(fields: [assignedClientId], references: [id], onDelete: SetNull)
  assignmentDate     DateTime?
  expirationDate     DateTime?
  renewalCount       Int              @default(0)
  currentRenewalMonth Int?
  serviceId          String?
  service            Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  renewals           Order[]          @relation("ProfileRenewals")
}

model Order {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId        String?
  service          Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  stripeSessionId  String?         @unique
  amount           Float
  status           String          // "PENDING", "PAID", "FAILED"
  type             String          // "PURCHASE" or "RENEWAL"
  profileAccountId String?
  profileAccount   ProfileAccount? @relation("ProfileRenewals", fields: [profileAccountId], references: [id], onDelete: SetNull)
  creditPackageId  String?         // Optional link to CreditPackage for credits purchases
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  invoices         Invoice[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status, createdAt])
}

model Invoice {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId           String?   @map("order_id")
  order             Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentPeriodStart DateTime? @map("payment_period_start")
  paymentPeriodEnd   DateTime? @map("payment_period_end")
  pdfPath           String    @map("pdf_path") // Path to the uploaded PDF invoice
  fileName          String    @map("file_name") // Original filename for display
  fileSize          String    @map("file_size") // Human-readable file size
  uploadedAt        DateTime  @map("uploaded_at") @default(now())
  createdAt         DateTime  @map("created_at") @default(now()) // For compatibility with application code
}

// ============================================
// CREDITS SYSTEM
// ============================================

model CreditPackage {
  id              String   @id @default(uuid())
  name            String
  description     String?
  creditsAmount   Int      @map("credits_amount")  // Number of credits in this package
  price           Float    // EUR price for the package
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
}

model CreditTransaction {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount          Int      // Positive for purchases, negative for spending
  balanceAfter    Int      @map("balance_after")  // Running balance after this transaction
  type            String   // "PURCHASE", "SPEND", "REFUND", "ADMIN_ADJUST"
  description     String   // Human-readable description
  referenceId     String?  @map("reference_id")  // Optional link to order/review
  metadata        String?  // JSON for additional context

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@index([userId, type, createdAt])  // For history queries
}

// ============================================
// REVIEWS SYSTEM
// ============================================

model ReviewOrder {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")   // Client who created the order
  user                  User     @relation("ReviewOrderClient", fields: [userId], references: [id], onDelete: Cascade)

  // Business Details
  businessName          String   @map("business_name")
  facebookUrl           String?  @map("facebook_url")   // Facebook URL for the review

  // Order Details
  orderType             String   @map("order_type")     // "REVIEW", "COMMENT", "COMMENT_WITH_PHOTO"
  gender                String?  @map("gender")         // "MALE" or "FEMALE", optional
  quantity              Int      // Number of reviews/comments

  // Review Details
  reviewType            String   @map("review_type")   // "GOOGLE", "TRUSTPILOT", "YELP", etc.
  reactionType          String?  @map("reaction_type")  // "LIKE", "LOVE", "CARE", "HAHA", "WOW", "SAD", "ANGRY" (only for COMMENT orders)
  reviewContent         String?  @map("review_content")   // The actual review text to post
  reviewInstructions    String?  @map("review_instructions")  // Additional instructions from client
  commentText           String?  @map("comment_text")   // Comment text for COMMENT types (comma-separated multiple comments)
  commentCount          Int      @default(1) @map("comment_count")  // Number of comments (1-50)
  completedComments     String?  @map("completed_comments")  // Comma-separated indices of completed comments "0,2,3"
  photoUrls             String?  @map("photo_urls")     // JSON array of photo URLs
  proofOfCompletion     String?  @map("proof_of_completion")  // Employee submission proof

  // Credits & Status
  creditsConsumed       Int      @map("credits_consumed") // Credits used for this order
  status                String   // "PENDING", "IN_PROGRESS", "COMPLETED", "CANCELLED"

  // Employee Assignment (kept for backward compatibility)
  assignedEmployeeId    String?  @map("assigned_employee_id")
  assignedEmployee      User?    @relation("ReviewOrderEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  assignedAt            DateTime? @map("assigned_at")

  // Employee Completion (NEW - who actually completed the order)
  completedByEmployeeId String?  @map("completed_by_employee_id")
  completedByEmployee   User?    @relation("ReviewOrderCompletedBy", fields: [completedByEmployeeId], references: [id], onDelete: SetNull)

  // Timestamps
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  completedAt           DateTime? @map("completed_at")

  // Admin Verification
  adminVerificationStatus String?  @map("admin_verification_status") // "APPROVED"
  adminVerifiedAt          DateTime? @map("admin_verified_at")

  // Multi-URL Support (NEW - Reviews System Redesign)
  reviewUrls             ReviewUrl[]            @relation("ReviewOrderUrls")
  totalUrls              Int                    @default(0) @map("total_urls")

  @@index([status])
  @@index([assignedEmployeeId])
  @@index([createdAt])
  @@index([assignedAt])
  @@index([adminVerificationStatus])
  @@index([userId, status, createdAt])  // For client order queries
  @@index([status, assignedEmployeeId])  // For admin queries
}

model EmployeeStats {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Availability
  isAvailable     Boolean  @default(true)

  // Task Distribution Control (NEW - Reviews System Redesign)
  acceptingTasks  Boolean  @default(true) @map("accepting_tasks")

  // Performance Tracking
  ordersCompleted  Int      @default(0) @map("orders_completed")
  creditsCompleted Int      @default(0) @map("credits_completed")  // NEW - Total credits earned
  lastActiveAt     DateTime?

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isAvailable])
  @@index([acceptingTasks])
}

// ============================================
// NOTIFICATIONS SYSTEM
// ============================================

model Notification {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title           String
  message         String
  type            String   // "INFO", "SUCCESS", "WARNING", "REVIEW_ORDER", etc.
  channels        String   // "TELEGRAM", "IN_APP", "EMAIL" (comma-separated)
  isRead          Boolean  @default(false)
  actionLink      String?  // Optional redirect URL
  relatedOrderId  String?  // Link to related review/order

  createdAt       DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model NotificationLog {
  id              String   @id @default(uuid())
  recipient       String
  subject         String
  body            String?
  type            String
  channel         String   @default("EMAIL")
  status          String   @default("SENT")
  priority        String   @default("MEDIUM") // "HIGH", "MEDIUM", "LOW"
  isRead          Boolean  @default(false)
  userId          String?  @db.Uuid
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedOrderId  String?
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([priority, createdAt(sort: Desc)])
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, priority, createdAt(sort: Desc)])
}

// ============================================
// REVIEW CREDIT PRICING
// ============================================

model ReviewCreditPricing {
  id              String   @id @default(uuid())
  orderType       String   @map("order_type")   // "REVIEW", "COMMENT", "COMMENT_WITH_PHOTO"
  creditsPerUnit  Int      @map("credits_per_unit")
  isActive        Boolean  @map("is_active") @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([orderType])
  @@index([isActive])
}

// ============================================
// TELEGRAM GROUP CONFIGS
// ============================================

model TelegramGroupConfig {
  id              String   @id @default(uuid())
  groupName       String   @map("group_name")
  groupChatId     String   @map("group_chat_id")
  groupType       String   @map("group_type")   // "ADMIN" or "EMPLOYEE"
  isActive        Boolean  @map("is_active") @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([groupType])
  @@index([isActive])
}

// ============================================
// APP SETTINGS
// ============================================

model AppSetting {
  id      String   @id @default(uuid())
  key     String   @unique
  value   String   // JSON string for flexible settings
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

// ============================================
// USER TELEGRAM CONFIGS
// ============================================

model UserTelegramConfig {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId    String   @map("chat_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId])
}

// ============================================
// REVIEWS SYSTEM REDESIGN - NEW MODELS
// ============================================

model ReviewUrl {
  id                  String   @id @default(uuid())
  reviewOrderId       String   @map("review_order_id")
  reviewOrder         ReviewOrder @relation("ReviewOrderUrls", fields: [reviewOrderId], references: [id], onDelete: Cascade)

  url                 String
  quantity            Int      @default(1)  // Number of reviews for this URL
  reactionType        String?  @map("reaction_type")  // For COMMENT orders only: LIKE, LOVE, CARE, WOW (null for REVIEW orders)
  reviewContent       String?  @map("review_content")  // JSON array of review texts for this URL
  photoUrls           String?  @map("photo_urls")  // JSON array of photo arrays (each review can have photos)
  reviewIndex         Int      @map("review_index")

  status              String   @default("PENDING") // "PENDING", "ASSIGNED", "COMPLETED"

  assignedEmployeeId  String?  @map("assigned_employee_id")
  assignedEmployee    User?    @relation("ReviewUrlEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  assignedAt          DateTime? @map("assigned_at")

  completedAt         DateTime? @map("completed_at")
  proofOfCompletion   String?  @map("proof_of_completion")

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([assignedEmployeeId])
  @@index([reviewOrderId])
  @@index([status, assignedEmployeeId, createdAt])  // For employee queries
}

model EmployeeEarnings {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance             Decimal  @default(0) @db.Decimal(10, 2)
  totalEarned         Decimal  @default(0) @map("total_earned") @db.Decimal(10, 2)
  currentPeriodEarned Decimal  @default(0) @map("current_period_earned") @db.Decimal(10, 2)

  status              String   @default("ACTIVE") // "ACTIVE", "FROZEN", "BANNED"

  payoutMethod        String?  @map("payout_method") // "BANK", "PAYPAL", "CRYPTO", etc.
  payoutDetails       String?  @map("payout_details") // JSON with payment details

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  transactions        EmployeeEarningTransaction[]
  payoutRequests      EmployeePayoutRequest[]

  @@index([status])
  @@index([userId])
}

model EmployeeEarningTransaction {
  id                  String   @id @default(uuid())
  employeeEarningsId  String   @map("employee_earnings_id")
  employeeEarnings    EmployeeEarnings @relation(fields: [employeeEarningsId], references: [id], onDelete: Cascade)

  type                String // "EARN", "PAYOUT", "ADJUSTMENT", "BONUS"
  amount              Decimal @db.Decimal(10, 2)
  balanceAfter        Decimal @map("balance_after") @db.Decimal(10, 2)

  description         String
  referenceOrderId    String?  @map("reference_order_id")
  referenceType       String?  @map("reference_type")
  metadata            String?

  createdAt           DateTime @default(now()) @map("created_at")

  @@index([employeeEarningsId])
  @@index([createdAt])
  @@index([type])
}

model EmployeeEarningRule {
  id              String   @id @default(uuid())

  orderType       String   @map("order_type") // "REVIEW", "COMMENT", "COMMENT_WITH_PHOTO"
  reviewType      String?  @map("review_type") // "FACEBOOK", "GOOGLE", etc. (null = all)
  reactionType    String?  @map("reaction_type") // "LIKE", "LOVE", etc. (null = all)

  paymentAmount   Decimal  @map("payment_amount") @db.Decimal(10, 2)
  currency        String   @default("EUR")

  isActive        Boolean  @default(true) @map("is_active")
  priority        Int      @default(0) // Higher priority checked first

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([priority])
  @@index([orderType])
}

model EmployeePayoutRequest {
  id                  String   @id @default(uuid())
  employeeEarningsId  String   @map("employee_earnings_id")
  employeeEarnings    EmployeeEarnings @relation(fields: [employeeEarningsId], references: [id])

  amount              Decimal @db.Decimal(10, 2)
  status              String   @default("PENDING") // "PENDING", "PROCESSING", "COMPLETED", "REJECTED"
  rejectionReason     String?  @map("rejection_reason")

  requestedAt         DateTime @default(now()) @map("requested_at")
  processedAt         DateTime? @map("processed_at")
  processedBy         String?  @map("processed_by")
  metadata            String?

  @@index([status])
  @@index([employeeEarningsId])
}
