{
  "buildCommand": "prisma generate && next build",
  "functions": {
    "app/api/**": {
      "memory": 1536,
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}